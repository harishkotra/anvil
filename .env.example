# --- Inference: default is Particle.ai (OpenAI-compatible) ---
OPENAI_BASE_URL=https://api.particle.ai/v1
OPENAI_API_KEY=pa-xxxxxxxx
MODEL=deepseek-v4.1-flash

# --- Optional add-ons the Settings panel offers ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=

# --- Sandbox defaults (overridable in the UI) ---
SANDBOX_TIMEOUT_S=10
SANDBOX_MEMORY_MB=512
SANDBOX_CPU_S=5
ALLOW_NETWORK=false
ALLOWED_READ_PATHS=./data
ALLOWED_WRITE_PATHS=./artifacts
MAX_OUTPUT_BYTES=200000
PORT=3001
